# Managed by ansible (botwhisper). Dev tokens live in dev-tokens.env, generated
# on this server on first deploy and never stored anywhere else.
BW_BIND={{ bw_relay_bind }}
BW_DATA=/var/lib/botwhisper/botwhisper.sqlite3
BW_PUBLIC_URL={{ bw_public_url }}
BW_ALLOWED_HOSTS={{ bw_allowed_hosts }}
BW_LOG={{ bw_log_level }}
BW_MAIL_TRANSPORT={{ bw_mail_transport }}
BW_SMTP_HOST={{ bw_smtp_host }}
BW_SMTP_PORT={{ bw_smtp_port }}
BW_SMTP_USERNAME={{ bw_smtp_username }}
BW_SMTP_PASSWORD={{ bw_smtp_password }}
BW_SMTP_TLS={{ bw_smtp_tls }}
BW_MAIL_FROM="{{ bw_mail_from }}"
