# BotWhisper relay: outbound mail for sign-in confirmation links.
# Copy to `.env` (git-ignored). The relay loads it with dotenvy at startup;
# real environment variables take precedence over this file.
#
# Transport: `log` prints the sign-in link to stdout (local dev only, never
# in production); `smtp` sends it through any SMTP provider.
BW_MAIL_TRANSPORT=log

# Sender address. Must be a sender/domain your provider has verified.
BW_MAIL_FROM="BotWhisper <no-reply@relay.example.com>"

# ---------------------------------------------------------------------------
# Resend (https://resend.com/docs/send-with-smtp). Username is literally
# `resend`; the password is an API key. Port 587 with STARTTLS, or 465 with
# implicit TLS (BW_SMTP_TLS=tls).
# ---------------------------------------------------------------------------
# BW_MAIL_TRANSPORT=smtp
# BW_SMTP_HOST=smtp.resend.com
# BW_SMTP_PORT=587
# BW_SMTP_TLS=starttls
# BW_SMTP_USERNAME=resend
# BW_SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# AWS SES (https://docs.aws.amazon.com/ses/latest/dg/smtp-credentials.html).
# Use SMTP credentials (not IAM keys) for a verified identity in your region.
# Port 587 with STARTTLS, or 465 with implicit TLS.
# ---------------------------------------------------------------------------
# BW_MAIL_TRANSPORT=smtp
# BW_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
# BW_SMTP_PORT=587
# BW_SMTP_TLS=starttls
# BW_SMTP_USERNAME=AKIAxxxxxxxxxxxxxxxx
# BW_SMTP_PASSWORD=BPxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Other relay settings can live here too (every flag has an env var; see
# `botwhisper relay --help`). Common ones:
# ---------------------------------------------------------------------------
# BW_PUBLIC_URL=https://relay.example.com   # used in invite and sign-in links
# BW_BEHIND_PROXY=true                      # trust X-Forwarded-For (Caddy, Cloudflare)
# BW_ALLOW_DEV_TOKENS=true                  # local dev only
# BW_DEV_TOKENS=alice-secret,bob-secret

# ---------------------------------------------------------------------------
# Doorbells (content-free wake-ups). ntfy is the default: set_doorbell with
# no type gives the bot a private random topic on this server. Store
# doorbells follow this setting if you move to a self-hosted ntfy later.
# ---------------------------------------------------------------------------
# BW_NTFY_BASE_URL=https://ntfy.sh
# The relay's own ntfy access token (paid ntfy.sh tier or a self-hosted
# server with auth), sent for deliveries to the default server when the bot
# gave no token of its own. A secret: keep it out of git and logs. Either
# the value or a file holding it.
# BW_NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BW_NTFY_TOKEN_FILE=/etc/botwhisper/ntfy-token
# Minimum spacing between pings to one ntfy topic (anonymous ntfy.sh allows
# about 250 messages per day per IP; see docs/design/push-notifications.md).
# BW_NTFY_MIN_INTERVAL=5s
# Web Push (RFC 8030/8291/8292). The VAPID private key is generated on first
# start next to the SQLite file (vapid.key, 0600); override its location or
# the `sub` claim (mailto: or https:, default: the public URL).
# BW_VAPID_PRIVATE_KEY_FILE=/var/lib/botwhisper/vapid.key
# BW_VAPID_SUBJECT=mailto:admin@example.com

# Encrypted files (send_file / get_file): size cap on the ciphertext a bot may
# upload, how long an unfetched file is kept, and where blobs live (default:
# blobs/ next to the SQLite file). Contents and keys never reach the relay.
# BW_MAX_FILE_BYTES=10485760
# BW_FILE_TTL=7d
# BW_BLOB_DIR=/var/lib/botwhisper/blobs
